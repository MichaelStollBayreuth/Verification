/*****************************************************************************

  section6.magma

  Magma code verifying the computational claims in Section 6
  ("A source of strange primes") of

    Maarten Derickx and Michael Stoll,
    Prime order torsion on elliptic curves over number fields,
    Part I: Asymptotics.

  Written for Magma V2.29 by Claude Code (Fable 5.1).

  The section considers genus 2 curves

    X : y^2 = r F1(x,z)^2 + s F1(x,z) F2(x,z) + t F2(x,z)^2,
        F1 = x z (x - z),  F2 = x^3 - x^2 z - 2 x z^2 + z^3,

  with the automorphism sigma : (x : y : z) -> (z : y : z - x) of order 3.
  This file checks, in the order of the paper,

    1. the symbolic claims about the family (invariance under sigma,
       fixed points, discriminant formula, squares mod 4,
       the reduction to the equation 27 t^2 + 2 u t - v^2 +- 16 = 0);
    2. the lists of primes p < 10^5 of the form m^2 + 108 and m^2 - 108,
       the curves attached to them by the Proposition in Section 6,
       their discriminants and conductors, the simplicity of their Jacobians
       and the (non)existence of points of infinite order;
       together with Table 2 this identifies the boldface primes;
    3. the proof of Proposition 6.5 (orders of the point Q modulo 3 and 5,
       the computation of 19 Q on the Kummer surface with w indeterminate,
       the reductions modulo 11), the remark about X_1(13),
       and the list of primes obtained for w <= 14.
       In addition it verifies that the character of the newforms attached
       to the Jacobian J_p has order exactly 6, by computing the Euler factor
       at 2, which depends only on w mod 4 (and actually not on w at all).

  Table 2 enters through the list TABLE2 defined in strange_primes.magma,
  which is loaded below; that file contains the code verifying Table 2.
  Run this file from the directory containing strange_primes.magma.

  Total running time: about 30 seconds.

*****************************************************************************/

load "strange_primes.magma"; // defines TABLE2 = [<p, n, strdim>, ...]

t0 := Cputime();

P<x> := PolynomialRing(Rationals());
F1 := x^2 - x;                 // F1(x, 1)
F2 := x^3 - x^2 - 2*x + 1;     // F2(x, 1)

function curve(r, s, t)
  return HyperellipticCurve(r*F1^2 + s*F1*F2 + t*F2^2);
end function;

// F1 and F2 as polynomials in the univariate polynomial ring PR
function F1F2(PR)
  y := PR.1;
  return y^2 - y, y^3 - y^2 - 2*y + 1;
end function;

// The sextic G(x, z) = r F1^2 + s F1 F2 + t F2^2 with r, s, t indeterminate.
R5<r, s, t, X, Z> := PolynomialRing(Integers(), 5);
G1 := X*Z*(X - Z);
G2 := X^3 - X^2*Z - 2*X*Z^2 + Z^3;
G := r*G1^2 + s*G1*G2 + t*G2^2;

printf "\n=============================================================================\n";
printf "1. The family of curves and its discriminant\n";
printf "=============================================================================\n\n";

// sigma(x : y : z) = (z : y : z - x) is an automorphism of X:
// (x, z) -> (z, z - x) maps F1 and F2 to -F1 and -F2, so G is invariant.
sigma := [r, s, t, Z, Z - X];
assert Evaluate(G1, sigma) eq -G1 and Evaluate(G2, sigma) eq -G2;
assert Evaluate(G, sigma) eq G;
// sigma has order 3 on P^1: applied three times, (x, z) -> (-x, -z).
assert Evaluate(Evaluate(Evaluate(X, sigma), sigma), sigma) eq -X
   and Evaluate(Evaluate(Evaluate(Z, sigma), sigma), sigma) eq -Z;
// The fixed points of x -> 1/(1-x) on P^1 are the roots of x^2 - x + 1.
// On such a point, G takes the value (r - s - 8t) + 3(s + t) x,
// which vanishes only if s = -t and r = 7t, and then the discriminant is zero
// (see below). So on a smooth curve X, sigma has exactly four fixed points,
// and by Riemann-Hurwitz (2 = 3 (2 g' - 2) + 4 * 2) the quotient X/<sigma>
// has genus g' = 0.
R3<rr, ss, tt> := PolynomialRing(Integers(), 3);
PR3<Y> := PolynomialRing(R3);
Gx := rr*(Y^2 - Y)^2 + ss*(Y^2 - Y)*(Y^3 - Y^2 - 2*Y + 1) + tt*(Y^3 - Y^2 - 2*Y + 1)^2;
assert Gx mod (Y^2 - Y + 1) eq (rr - ss - 8*tt) + 3*(ss + tt)*Y;

// The discriminant of the model (in the normalization of Magma and Liu,
// Disc(y^2 = f) = 2^8 Disc(f) for a sextic f) is
//   Delta(r, s, t) = 2^8 (s^2 - 4 r t)^3 ((1/4) ((2r + s - 13t)^2 + 27 (s + t)^2))^2 .
Delta := 2^8 * Discriminant(Gx);
fl, quart := IsDivisibleBy((2*rr + ss - 13*tt)^2 + 27*(ss + tt)^2, 4);
assert fl; // the last factor is an integer
assert Delta eq 2^8 * (ss^2 - 4*rr*tt)^3 * quart^2;
assert Evaluate(Delta, [7, -1, 1]) eq 0; // singular when s = -t, r = 7t
// check the normalization against Magma's Discriminant of a curve
assert Discriminant(curve(5, 2, 1)) eq Evaluate(Delta, [5, 2, 1]);
printf "Discriminant formula verified.\n";

// If not all of r, s, t are divisible by 4, then G is a square modulo 4
// exactly when (r, s, t) = (0, 0, 1), (1, 0, 0) or (1, 2, 1) mod 4.
Z4 := Integers(4);
P4<y> := PolynomialRing(Z4);
squares := {(a*y^3 + b*y^2 + c*y + d)^2 : a, b, c, d in Z4};
F1_4, F2_4 := F1F2(P4);
good := {[a, b, c] : a, b, c in Z4 | a*F1_4^2 + b*F1_4*F2_4 + c*F2_4^2 in squares};
assert good eq {[0, 0, 0], [0, 0, 1], [1, 0, 0], [1, 2, 1]};
// In these cases, 16 divides s^2 - 4 r t.
assert forall{[a, b, c] : a, b, c in [0..15]
                        | [a mod 4, b mod 4, c mod 4] notin good
                          or (b^2 - 4*a*c) mod 16 eq 0};
printf "Squares modulo 4 classified.\n";

// Un-completing the square (y = 2y' + h with G = h^2 + 4 g) gives the model
// y'^2 + h y' = g, whose discriminant is Delta / 2^20. This is checked on
// each curve below (via MinimalWeierstrassModel).

// With u = 2r + s - 13t and v = s + t, we have r = (u - v)/2 + 7t, s = v - t,
// s^2 - 4rt = -(27 t^2 + 2 u t - v^2), and if u^2 + 27 v^2 = 4p,
// then the discriminant of 27 t^2 + 2 u t - v^2 +- 16 as a polynomial in t
// is 16 (p -+ 108).
Q3<u, v, T> := PolynomialRing(Rationals(), 3);
rT := (u - v)/2 + 7*T; sT := v - T;
assert 2*rT + sT - 13*T eq u and sT + T eq v;
assert sT^2 - 4*rT*T eq -(27*T^2 + 2*u*T - v^2);
for sign in [1, -1] do
  quadratic := 27*T^2 + 2*u*T - v^2 + sign*16;
  disc := Coefficient(quadratic, T, 1)^2 - 4*Coefficient(quadratic, T, 2)*Coefficient(quadratic, T, 0);
  assert disc eq 4^2 * ((u^2 + 27*v^2)/4 - sign*108);
end for;
// Changing the sign of v corresponds to the substitution x -> 1 - x,
// which maps (r, s, t) to (r + s + t, -s - 2t, t);
// so the Proposition does not depend on the sign of v.
assert Evaluate(G, [r, s, t, Z - X, Z]) eq Evaluate(G, [r + s + t, -s - 2*t, t, X, Z]);
assert 2*(r + s + t) + (-s - 2*t) - 13*t eq 2*r + s - 13*t and (-s - 2*t) + t eq -(s + t);
printf "Reduction to 27 t^2 + 2 u t - v^2 +- 16 = 0 verified.\n\n";

printf "\n=============================================================================\n";
printf "2. The primes p = m^2 +- 108 below 10^5 and their curves\n";
printf "=============================================================================\n\n";

// The lists as printed in the paper.
list_plus := [109, 157, 229, 277, 397, 733, 1069, 1789, 2917, 4597, 5437, 6037, 6997, 7333,
              8389, 9133, 15733, 19429, 24133, 26029, 27997, 28669, 32869, 37357, 38917, 39709,
              43789, 51637, 55333, 58189, 60133, 67189, 72469, 76837, 87133, 90709, 93133];
list_minus := [13, 61, 181, 421, 733, 853, 1117, 1741, 2293, 2917, 3373, 3613, 4933, 5821, 6133,
               6781, 10093, 10501, 14533, 17053, 17581, 18661, 19213, 20341, 22093, 23917,
               30517, 32653, 36373, 43573, 48733, 51421, 54181, 55117, 57973, 60901, 63901,
               66973, 69061, 70117, 72253, 78853, 82261, 89293, 97861];
boldface := [61, 181, 421, 733, 853, 2917, 5821, 6133, 6781, 10093, 14533, 17053, 20341, 22093,
             36373, 48733, 63901, 66973, 69061];
assert list_plus eq [p : p in PrimesUpTo(10^5) | IsSquare(p - 108)];
assert list_minus eq [p : p in PrimesUpTo(10^5) | IsSquare(p + 108)];
assert #list_plus eq 37 and #list_minus eq 45;
assert Set(list_plus) meet Set(list_minus) eq {733, 2917};
printf "The two lists of primes are correct (%o and %o primes; 733 and 2917 are in both).\n",
       #list_plus, #list_minus;

// Comparison with Table 2: the boldface primes are exactly the primes p = m^2 - 108
// that are strange, and at each of them Table 2 has the single entry (p, 6, 2)
// (one Galois orbit of two strange newforms with character of order 6).
// None of the other primes of the two lists is strange.
strange_primes := {e[1] : e in TABLE2};
assert Set(boldface) eq {p : p in list_minus | p in strange_primes};
assert forall{p : p in boldface | [e : e in TABLE2 | e[1] eq p] eq [<p, 6, 2>]};
assert forall{p : p in list_plus | p notin strange_primes or p in {733, 2917}};
// The order 6 strange characters at 1861 and 15061 (orbits of length 6 and 4):
assert {e : e in TABLE2 | e[2] eq 6 and e[3] ne 2} eq {<1861, 6, 6>, <15061, 6, 4>};
assert forall{p : p in [1861, 15061] | not IsSquare(p - 108) and not IsSquare(p + 108)};
printf "The boldface primes are the primes of the second list that occur in Table 2,\n";
printf "each with a single strange orbit of length 2 and character of order 6.\n\n";

// Representation 4p = u^2 + 27 v^2 with u, v >= 0
function rep_4p(p)
  for v in [0..Isqrt(4*p div 27)] do
    fl, u := IsSquare(4*p - 27*v^2);
    if fl then return u, v; end if;
  end for;
  error "no representation 4p = u^2 + 27 v^2";
end function;

// The curve of the Proposition for p = m^2 + eps*108 (eps = 1 or -1).
function curve_from_prime(p, eps)
  fl, m := IsSquare(p - eps*108); assert fl;
  u, v := rep_4p(p);
  assert u^2 + 27*v^2 eq 4*p;
  // u = +-2m mod 27; choose the sign of u such that u = 2m mod 27
  if (u - 2*m) mod 27 ne 0 then u := -u; end if;
  assert (u - 2*m) mod 27 eq 0;
  t := ExactQuotient(2*m - u, 27);
  assert IsEven(u - v);
  r := ExactQuotient(u - v, 2) + 7*t;
  s := v - t;
  // the two defining equations
  assert s^2 - 4*r*t eq eps*16;
  assert (2*r + s - 13*t)^2 + 27*(s + t)^2 eq 4*p;
  // choose the sign so that (r, s, t) = (0, 0, 1), (1, 0, 0) or (1, 2, 1) mod 4
  if [r mod 4, s mod 4, t mod 4] notin {[0, 0, 1], [1, 0, 0], [1, 2, 1]} then
    r := -r; s := -s; t := -t;
  end if;
  assert [r mod 4, s mod 4, t mod 4] in {[0, 0, 1], [1, 0, 0], [1, 2, 1]};
  return curve(r, s, t), r, s, t, u, v, m;
end function;

// Now check all 84 curves. For each curve we verify:
//  * the model has discriminant +-2^20 p^2 and the minimal model
//    has discriminant +-p^2 = Delta/2^20 (the paper only needs that the
//    conductor divides p^2; we also let Magma compute the conductor);
//  * the Jacobian J is simple over Q (the Euler factor at 2 is irreducible over Q);
//  * for p = m^2 + 108: t = 0, s = +-4, the curve is isomorphic to
//      y^2 = x z (x - z) (r' x z (x - z) + 4 F2)  with r' = +-m - 2 = 1 mod 4,
//    the cubic factor has cyclic Galois group, 2 is a cube mod p,
//    and the alternative r' = +-m + 2, s = -4 gives an isomorphic curve;
//  * the rank of J(Q): for the boldface primes we exhibit a point
//    of infinite order; for the other primes, the 2-descent rank bound is 0 in most cases,
//    and otherwise the rank must be 0 because p is not strange (see below).
//
// Argument for the last point (from the paper): J is simple with Z[omega] in
// End(J) and conductor p^2, so J is isogenous to A_g for a newform g of level p
// with nontrivial character chi whose Galois orbit has length 2 = dim J. If
// J(Q) has positive rank, then L(g, 1) = 0 by Kolyvagin-Logachev and Kato,
// so g is strange and p is a strange prime. Conversely, if p is strange
// with the single strange orbit of Table 2 and J(Q) has positive rank,
// then g's orbit is that strange orbit, which has character of order 6.
// This shows that the boldface primes are exactly the primes p = m^2 - 108
// whose curve has a Jacobian of positive rank, and that the strange newforms
// at these primes are the newforms attached to these curves.

curves := AssociativeArray(); // p -> [curves] (two curves for 733 and 2917)
rank_by_table2 := [];         // curves where the rank bound is not 0
printf "Checking the %o curves ...\n", #list_plus + #list_minus + 2;
for eps in [1, -1] do
  for p in (eps eq 1 select list_plus else list_minus) do
    C, r, s, t, u, v, m := curve_from_prime(p, eps);
    assert Abs(Integers()!Discriminant(C)) eq 2^20 * p^2;
    Cmin := MinimalWeierstrassModel(C);
    assert Abs(Integers()!Discriminant(Cmin)) eq p^2;
    assert Conductor(Cmin) eq p^2;
    J := Jacobian(Cmin);
    // J is simple: Euler factor at 2 (J has good reduction at 2) is irreducible
    assert IsIrreducible(LPolynomial(ChangeRing(Cmin, GF(2))));
    if eps eq 1 then
      assert t eq 0 and u eq 2*m and v eq 4 and Abs(s) eq 4;
      r1 := (m - 2) mod 4 eq 1 select m - 2 else -m - 2;
      assert r1 mod 4 eq 1;
      assert IsIsomorphic(C, curve(r1, 4, 0));
      assert IsIsomorphic(C, curve(r1 + 4, -4, 0)); // the alternative r' = +-m + 2, s = -4
      cubic := r1*F1 + 4*F2;
      assert IsIrreducible(cubic) and IsSquare(Discriminant(cubic)); // cyclic cubic
      assert IsPower(GF(p)!2, 3); // 2 is a cubic residue mod p
    else
      assert t ne 0;
    end if;
    if eps eq -1 and p in boldface then
      // a point of infinite order on J
      pts := Points(J : Bound := 100);
      assert exists{pt : pt in pts | Order(pt) eq 0};
    else
      rb := RankBound(J);
      if rb ne 0 then
        assert p notin strange_primes; // then rank 0 by the argument above
        // (this excludes the curves with p = m^2 + 108 at p = 733 and 2917)
        Append(~rank_by_table2, <p, eps, rb>);
      end if;
    end if;
    if IsDefined(curves, p) then Append(~curves[p], C); else curves[p] := [C]; end if;
  end for;
end for;
// The two curves for 733 and 2917 are not isomorphic.
assert forall{p : p in [733, 2917] | #curves[p] eq 2 and not IsIsomorphic(curves[p,1], curves[p,2])};
printf "All curves have minimal discriminant +-p^2 and conductor p^2, and simple Jacobians.\n";
printf "The Jacobians of the curves at the boldface primes have positive rank.\n";
printf "The Jacobians of the other curves have rank 0. In the following cases, the\n";
printf "2-descent rank bound is positive, and rank 0 follows from Table 2 (p is not strange):\n";
for e in rank_by_table2 do
  printf "  p = %o = m^2 %o 108: rank bound %o\n", e[1], e[2] eq 1 select "+" else "-", e[3];
end for;
printf "In particular, none of the curves with p = m^2 + 108 has positive rank.\n\n";

printf "\n=============================================================================\n";
printf "3. Proposition 6.5\n";
printf "=============================================================================\n\n";

// The curve X_p with w indeterminate
F<w> := FunctionField(Rationals());
PF<xF> := PolynomialRing(F);
PZ<wZ> := PolynomialRing(Integers());
pZ := wZ^4 + 2*wZ^3 + 23*wZ^2 + 22*wZ + 13; // p as a polynomial in w
pw := Evaluate(pZ, w);
mw := w^2 + w + 11;
assert pw eq mw^2 - 108;
uw := 2*w^2 + 2*w - 5; vw := 2*w + 1;
assert uw^2 + 27*vw^2 eq 4*pw;
assert (2*mw - uw)/27 eq 1;
rw := w^2 + 4; sw := 2*w; tw := 1;
assert rw eq (uw - vw)/2 + 7*tw and sw eq vw - tw;
assert sw^2 - 4*rw*tw eq -16 and (2*rw + sw - 13*tw)^2 + 27*(sw + tw)^2 eq 4*pw;
// (r, s, t) = (0, 0, 1) or (1, 2, 1) mod 4 according as w is even or odd
assert forall{w0 : w0 in [0..3] | [(w0^2 + 4) mod 4, 2*w0 mod 4, 1] in {[0, 0, 1], [1, 2, 1]}};
// (note: PF!F1 would map x to w, into the coefficient field, so we rebuild F1, F2 in PF)
F1w, F2w := F1F2(PF);
fw := rw*F1w^2 + sw*F1w*F2w + tw*F2w^2;
Xw := HyperellipticCurve(fw);
Jw := Jacobian(Xw);
assert Discriminant(Xw) eq -2^20*pw^2;
// The point P = (0 : 1 : 1) and Q = [P - iota(P)]
Pw := Xw![0, 1];
Qw := Pw - (-Pw);
assert Qw eq Jw![xF^2, 1 - (w + 2)*xF];
printf "Setup of X_p and Q = [P - iota(P)] verified.\n";

// Reduction of X_p and Q modulo 3 and 5 (X_p has good reduction at l
// since l does not divide p; p mod l depends only on w mod l).
function reduce_Q(w0, l)
  // w0: element of GF(l); returns the reduction of Q on the Jacobian of X_p mod l
  Pl<xl> := PolynomialRing(GF(l));
  F1l, F2l := F1F2(Pl);
  f := (w0^2 + 4)*F1l^2 + 2*w0*F1l*F2l + F2l^2;
  assert Discriminant(f) ne 0;
  J := Jacobian(HyperellipticCurve(f));
  return J![xl^2, 1 - (w0 + 2)*xl];
end function;
for l in [3, 5] do
  assert forall{w0 : w0 in GF(l) | Evaluate(pZ, w0) ne 0}; // good reduction for all w
  orders := [Order(reduce_Q(w0, l)) : w0 in GF(l)];
  printf "orders of Q modulo %o for w = 0, ..., %o: %o\n", l, l - 1, orders;
  for w0 in GF(l) do
    ord := orders[Integers()!w0 + 1];
    if w0*(w0 + 1) eq 0 then
      assert ord eq 19;
    else
      assert (l eq 3 and ord eq 3) or (l eq 5 and ord in {6, 9});
    end if;
  end for;
end for;
// Hence: if Q has finite order N, then N = 19 (and 15 | w^2 + w),
// since the reduction modulo an odd prime of good reduction is injective on torsion.

// 19 Q on the Kummer surface with w indeterminate
Kw := KummerSurface(Jw);
time Q19 := 19 * (Kw ! Qw);
coords := Eltseq(Q19);
den := LCM([Denominator(c) : c in coords]);
PQ<W> := PolynomialRing(Rationals());
coords := [PQ | c * den : c in coords]; // polynomials in w
g := GCD(coords);
coords := [ExactQuotient(c, g) : c in coords]; // now no common factor
printf "degrees of the coordinates of 19 Q: %o\n", [Degree(c) : c in coords];
// 19 Q_w0 = 0 iff the first three coordinates vanish at w0.
g3 := GCD(coords[1..3]);
printf "gcd of the first three coordinates: %o\n", Factorization(g3);
assert {rt[1] : rt in Roots(g3)} eq {0, -1};
assert forall{w0 : w0 in [0, -1] | Evaluate(coords[4], w0) ne 0};
printf "19 Q = 0 only for w = 0 and w = -1.\n";
// So Q has infinite order for all integers w not in {-1, 0}.

// Reductions mod 11: irreducible L-polynomial for all w with 11 not dividing p
for w0 in GF(11) do
  if Evaluate(pZ, w0) eq 0 then
    assert w0 eq 5;
    continue;
  end if;
  Pl<xl> := PolynomialRing(GF(11));
  F1l, F2l := F1F2(Pl);
  f := (w0^2 + 4)*F1l^2 + 2*w0*F1l*F2l + F2l^2;
  assert IsIrreducible(LPolynomial(HyperellipticCurve(f)));
end for;
printf "All reductions of X_p mod 11 have irreducible L-polynomial; so J_p is simple.\n";

// The character has order 6:
// J_p is of GL_2-type with End(J_p) containing Z[omega], so J_p is isogenous to A_g
// for a newform g of level p with character chi of order 2, 3 or 6
// (chi takes values in the Hecke field Q(omega)). For a prime l of good reduction,
// the L-polynomial of J_p mod l factors over Q(omega) as
//   (1 - a_l T + chi(l) l T^2) (1 - conj(a_l) T + conj(chi(l)) l T^2) ,
// which determines chi(l) up to conjugation.
// We take l = 2: the minimal model of X_p at 2 has good reduction,
// and its reduction mod 2 depends only on w mod 4, since the sextic f_w mod 8 does;
// so it suffices to look at w = 0, 1, 2, 3.
// In all four cases chi(2) is a primitive 6th root of unity.
// (In fact, we always find the same Euler factor.)
Kom<om> := CyclotomicField(3);
PK<TK> := PolynomialRing(Kom);
PW<WW> := PolynomialRing(Rationals());
PWx<xW> := PolynomialRing(PW);
for w0 in [0..3] do
  // f_{w0 + 4 W} = f_{w0} mod 8
  F1W, F2W := F1F2(PWx);
  f1 := ((w0 + 4*WW)^2 + 4)*F1W^2 + 2*(w0 + 4*WW)*F1W*F2W + F2W^2;
  f0 := (w0^2 + 4)*F1W^2 + 2*w0*F1W*F2W + F2W^2;
  assert forall{c : c in Coefficients(f1 - f0) | forall{cc : cc in Coefficients(c) | IsDivisibleBy(Integers()!cc, 8)}};
  C0 := curve(w0^2 + 4, 2*w0, 1);
  C0min := MinimalWeierstrassModel(C0);
  assert IsOdd(Integers()!Discriminant(C0min)); // good reduction at 2
  L2 := LPolynomial(ChangeRing(C0min, GF(2)));
  fact := Factorization(PK!L2);
  assert #fact eq 2 and forall{e : e in fact | Degree(e[1]) eq 2 and e[2] eq 1};
  q1 := fact[1,1]; // monic: T^2 - (a/c) T + 1/c with c = 2 chi(2), up to conjugation
  chi2 := Coefficient(q1, 2)/Coefficient(q1, 0)/2;
  assert chi2^6 eq 1 and chi2^2 ne 1 and chi2^3 ne 1; // primitive 6th root of unity
  printf "w = %o mod 4: L-polynomial at 2 is %o,\n             chi(2) = %o\n", w0, L2, chi2;
end for;
printf "The character of the newforms attached to J_p has order 6.\n";

// Sanity check (not needed for the proof): Q has infinite order for w = 1, ..., 30
assert forall{w0 : w0 in [1..30] | Order(Jacobian(curve(w0^2 + 4, 2*w0, 1))![x^2, 1 - (w0 + 2)*x]) eq 0};

// The remark: for w = -1 and w = 0, p = 13, and X_p is X_1(13)
// (Ogg's model y^2 = x^6 - 2x^5 + x^4 - 2x^3 + 6x^2 - 4x + 1, LMFDB 169.a.169.1),
// whose Jacobian has rank 0 and rational torsion subgroup of order 19.
X0 := curve(4, 0, 1); Xm1 := curve(5, -2, 1);
X1_13 := HyperellipticCurve(x^6 - 2*x^5 + x^4 - 2*x^3 + 6*x^2 - 4*x + 1);
assert Evaluate(pZ, 0) eq 13 and Evaluate(pZ, -1) eq 13;
assert IsIsomorphic(X0, Xm1) and IsIsomorphic(X0, X1_13);
assert IsIsomorphic(X0, HyperellipticCurve(x^5 + x^4, x^3 + x + 1)); // LMFDB 169.a.169.1
assert Conductor(X0) eq 169;
J0 := Jacobian(X0);
assert RankBound(J0) eq 0 and Invariants(TorsionSubgroup(J0)) eq [19];
assert Order(J0![x^2, 1 - 2*x]) eq 19;
printf "For w = -1, 0, X_p is X_1(13), with J(Q) = Z/19.\n";

// The primes p for w = 1, ..., 14
ws := [w0 : w0 in [1..14] | IsPrime(Evaluate(pZ, w0))];
assert ws eq [1, 2, 3, 4, 8, 9, 10, 11, 14];
assert [Integers()!Evaluate(pZ, w0) : w0 in ws] eq [61, 181, 421, 853, 6781, 10093, 14533, 20341, 48733];
assert forall{w0 : w0 in ws | Integers()!Evaluate(pZ, w0) in boldface};
printf "For w <= 14, Proposition 6.5 gives the primes %o.\n", [Integers()!Evaluate(pZ, w0) : w0 in ws];

printf "\nAll claims in Section 6 verified. Total time: %o seconds.\n", Cputime(t0);
