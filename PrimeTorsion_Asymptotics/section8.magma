/*****************************************************************************

  section8.magma

  Magma code verifying the computational claims in Section 8
  ("Small degree points on X_0(p)") of

    Maarten Derickx and Michael Stoll,
    Prime order torsion on elliptic curves over number fields,
    Part I: Asymptotics.

  Written for Magma V2.29 by Claude Code (Fable 5.1).

  For a prime p, perdim(p) is the number of weight 2 newforms f
  for Gamma_0(p) with w(f) = -f and L(f, 1) = 0 (i.e., with positive even
  analytic rank), where w is the Fricke involution. This file checks

    1. Table 3: the 111 primes p < 10^4 with perdim(p) > 0 and the values
       perdim(p), together with the structure of the Galois orbits
       (997, 1913, 2843, 9829 have two orbits). This is an independent
       computation with modular symbols (see below), which is then compared
       with the table and with the LMFDB data (lmfdb_mf_newforms_rk_ge_2.m);
    2. the statements about Cowan's data for 10^4 < p < 10^6, as provided
       by the LMFDB (lmfdb_mf_newforms_dim_le_6.m: all Galois orbits of
       size at most 6 with their Fricke signs), and the determination of
       the primes p < 10^6 with perdim(p) > 4;
    3. the counts of elliptic curves of prime conductor with positive even
       rank in the LMFDB (lmfdb_ec_curvedata_0417_1729.m).

  Computation of perdim(p). Let M = M_2(Gamma_0(p))^+ be the plus quotient
  of the space of modular symbols, S its cuspidal subspace, T the Hecke
  algebra and e = {0, oo} the winding element. The Fricke involution w acts
  on M and commutes with the T_l, l != p; it swaps the cusps 0 and oo, so
  w e = -e. Let S^- be the (-1)-eigenspace of w on S. The newforms f with
  L(f, 1) != 0 all lie in S^- (the pairing between modular symbols and cusp
  forms is w-equivariant), and the T-module T e' generated by the cuspidal
  projection e' = e (T_2 - 3) of e (the Eisenstein part of M is
  one-dimensional with T_2-eigenvalue 3) is the sum of the f-isotypic parts
  of S^- over the newforms f with L(f, 1) != 0. Hence

      perdim(p) = dim S^- - dim T e' .

  As in strange_primes.magma (whose helper functions and constants are
  used; the file is loaded below), dim T e' is computed modulo a prime
  q > 2^22 as the rank of the Krylov space of e' under T_2, enlarged by
  further Hecke operators if necessary. Since the rank can only drop under
  reduction, this gives an upper bound d for perdim(p), and d = 0 proves
  perdim(p) = 0. If d > 0, the characteristic polynomial of some T_l on the
  quotient S^- / T e' (mod q) is lifted to Z (its coefficients are bounded
  by binom(d, k) (2 sqrt(l))^k, and q is large enough for the lift to be
  unique) and the kernel of this polynomial in T_l on M over Q is decomposed
  into newform pieces; the pieces with Fricke eigenvalue -1 and vanishing
  winding element projection have positive even analytic rank. If their
  dimensions add up to d, then perdim(p) = d, with these Galois orbits.

  Data files (downloaded from the LMFDB on 2026-09-28 in Magma format; the
  query URLs are in the file headers):
    lmfdb_mf_newforms_rk_ge_2.m   newforms for Gamma_0(p), p prime, weight 2,
                                  analytic rank >= 2 (116 forms)
    lmfdb_mf_newforms_dim_le_6.m  newforms for Gamma_0(p), 10^4 <= p prime,
                                  weight 2, dimension <= 6 (11198 forms)
    lmfdb_ec_curvedata_even_rank.m  elliptic curves of prime conductor and
                                  rank 2, 4 or >= 6, one per isogeny class
                                  (144952 curves)
  The same data had been downloaded on 2020-12-31 (analytic rank >= 2),
  2025-04-25 (dimension <= 6) and 2025-04-17 (elliptic curves); the data
  are unchanged. Run this file from the directory containing these files
  and strange_primes.magma.

  Total running time: about one hour (10 minutes for the 1229 primes below
  10^4, the rest for the modular symbols computations at eight primes
  between 10^4 and 2 * 10^5; the largest of them, p = 171713, takes
  22 minutes and needs up to ~18 GB of memory).

*****************************************************************************/

load "strange_primes.magma"; // helper functions and the constants Q_MIN, L_MAX

t0 := Cputime();

//============================================================================
// Computation of perdim(p)
//============================================================================

// The Hecke operator T_l on the modular symbols space M as a sparse matrix.
// Magma caches every Hecke operator computed on M as a dense matrix, which
// for p ~ 10^5 costs more than 1 GB per operator; we clear this cache.
function sparse_hecke_lean(M, l)
  T := SparseMatrix(HeckeOperator(M, l));
  M`hecke_operator := [];
  return T;
end function;

// Screening modulo q. Returns <d, l, coeffs, q, T2, W>, where d = 0
// if perdim(p) = 0 is certified; otherwise d >= 1 is an upper bound for
// perdim(p) and coeffs are the (integer) coefficients of the characteristic
// polynomial of T_l on the deficient quotient. T2 and W are the sparse
// matrices of T_2 and of w on the modular symbols space over F_q (input for
// verify_perdim).
function screen_perdim(p)
  t0 := Cputime();
  q := aux_prime(p);
  Fq := GF(q);
  PF := PolynomialRing(Fq);
  M := ModularSymbols(p, 2, Fq, +1);
  V, VtoM, MtoV := VectorSpace(M);
  Wp := AtkinLehnerOperator(M, p);
  Ws := SparseMatrix(Wp);
  delete M`atkin_lehner; // the dense matrix is cached in M as well
  e := MtoV(WindingElement(M));
  assert e*Ws eq -e; // w swaps the cusps 0 and oo
  // S^- = the (-1)-eigenspace of w on the cuspidal subspace = kernel of w + 1
  // and of the boundary map
  VSm := Kernel(HorizontalJoin(Wp + 1, BoundaryMap(M)));
  delete Wp;
  dSm := Dimension(VSm);
  assert dSm eq ExactQuotient(Dimension(M) - 1 - Trace(Ws) - 1, 2); // trace of w on S is Trace(Ws) + 1
  t1 := Cputime(t0);
  vprintf User2: "  p = %o: dim S = %o, dim S^- = %o (%o s)\n", p, Dimension(M) - 1, dSm, t1;
  ops := AssociativeArray(Integers()); // sparse Hecke operators, indexed by l
  ops[2] := sparse_hecke_lean(M, 2);
  if dSm eq 0 then return <0, 2, [1], q, ops[2], Ws>; end if;
  e1 := e*ops[2] - 3*e; // e' = e (T_2 - 3), the cuspidal projection of e
  assert not IsZero(e1);
  // Common case: the Krylov space of e' under T_2 is all of S^-.
  rows := krylov_rows(e1, ops[2], dSm);
  r := Rank(Matrix(rows));
  vprintf User2: "    Krylov rank %o (%o s)\n", r, Cputime(t0) - t1;
  if r eq dSm then return <0, 2, [1], q, ops[2], Ws>; end if;
  // Rank deficiency: proceed as in screen_character of strange_primes.magma,
  // with S^- in place of S.
  W := sub<VSm | rows>;
  delete rows;
  gens := [2];
  lp := 0;
  kerpol := PF!1;
  while true do
    for l in [l : l in PrimesUpTo(L_MAX) | l ne p and l notin gens] do
      T := sparse_hecke_lean(M, l);
      if VSm!(Random(W)*T) notin W then
        vprintf User2: "    Hecke module not stable under T_%o; enlarging\n", l;
        Append(~gens, l);
        ops[l] := T;
        W := saturate(W, VSm, ops, gens, dSm);
        if Dimension(W) eq dSm then return <0, 2, [1], q, ops[2], Ws>; end if;
      end if;
    end for;
    r := Dimension(W);
    d := dSm - r;
    Q, pi := quo<VSm | W>;
    B := [Q.i @@ pi : i in [1..d]];
    BW := Basis(W);
    found := false;
    for l in Sort(gens) do
      mat := Matrix([Eltseq(pi(VSm!(b*ops[l]))) : b in B]);
      kerpol := CharacteristicPolynomial(mat);
      if r eq 0 or Rank(Matrix([pol_mat_vec(kerpol, ops[l], b) : b in BW])) eq r then
        found := true;
        lp := l;
        break;
      end if;
    end for;
    if found then break; end if;
    l := 1;
    repeat l := NextPrime(l); until l ne p and l notin gens;
    error if l gt 200, "screen_perdim: no separating Hecke operator T_l with l <= 200";
    Append(~gens, l);
    ops[l] := sparse_hecke_lean(M, l);
    W := saturate(W, VSm, ops, gens, dSm);
    if Dimension(W) eq dSm then return <0, 2, [1], q, ops[2], Ws>; end if;
  end while;
  // Lift the coefficients to integers (symmetric residues mod q).
  // The coefficient of x^i of the true polynomial is bounded in absolute value
  // by binom(d, d-i) (2 sqrt(l))^(d-i), so the lift is correct if q exceeds
  // twice that bound.
  coeffs := [Integers()| ];
  for i := 0 to d do
    c := Integers()!Coefficient(kerpol, i);
    if 2*c gt q then c -:= q; end if;
    bound := Binomial(d, d-i) * (2*Sqrt(lp))^(d-i);
    error if q lt 2*bound + 1, "screen_perdim: q is too small to determine the lift uniquely";
    error if Abs(c) gt bound, "screen_perdim: lift is too large to be correct";
    Append(~coeffs, c);
  end for;
  vprintf User2: "    defect %o, kernel polynomial for T_%o: %o (%o s)\n",
                 d, lp, coeffs, Cputime(t0);
  return <d, lp, coeffs, q, ops[2], Ws>;
end function;

// Decomposition of a Hecke stable subspace A of M (such as the kernel of
// kerpol(T_l)) into Galois orbits of newforms. The Hecke operators are
// semisimple, so A is the direct sum of the kernels of g(T_l) over the
// irreducible factors g of the characteristic polynomial of T_l on A, and
// these kernels are Hecke stable; if there is only one factor and its degree
// is dim A, then the T_l-eigenspaces on A are one-dimensional and are
// permuted transitively by the Galois group, so A is a single orbit.
// We apply this recursively with l = 2, 3, 5, ... (all computations take place
// in the small space A). NewformDecomposition is used only as a last resort.
// This is only used for p < 10^4: for large p, Hecke operators on subspaces
// of M over Q are very slow in Magma.
function newform_orbits(A, p)
  for l in [l : l in PrimesUpTo(L_MAX) | l ne p] do
    fact := Factorization(CharacteristicPolynomial(HeckeOperator(A, l)));
    if #fact eq 1 then
      if Degree(fact[1,1]) eq Dimension(A) then return [A]; end if;
    else
      return &cat[newform_orbits(Kernel([<l, g[1]>], A), p) : g in fact];
    end if;
  end for;
  vprintf User2: "    using NewformDecomposition on a piece of dimension %o\n", Dimension(A);
  return NewformDecomposition(A);
end function;

// The reduction modulo q of a subspace A of the modular symbols space over Q,
// given by its dual representation (the subspace of the dual of the
// ambient space that Magma computes for kernels of Hecke operators;
// a basis of A itself would be expensive to obtain):
// a sequence of vectors over F_q, the reductions of the (integral, primitive)
// basis vectors of the dual space of A. They are linearly independent,
// since the basis is in echelon form and q does not divide any denominator
// (this is checked in the code).
function reduce_dual_mod_q(A, Fq)
  rows := [];
  for v in Basis(DualVectorSpace(A)) do
    den := LCM([Denominator(c) : c in Eltseq(v)]);
    assert den mod Characteristic(Fq) ne 0;
    Append(~rows, ChangeRing(v*den, Fq));
  end for;
  assert Rank(Matrix(rows)) eq #rows;
  return rows;
end function;

// Verification in characteristic 0 (see above). q, T2q and Wq are as
// returned by screen_perdim. Returns <perdim, orbits, confirmed>,
// where confirmed is true if and only if perdim(p) = d was proved,
// and orbits are the sizes of the Galois orbits of newforms with positive
// even analytic rank (only determined if the parameter orbits is true;
// otherwise the sequence is empty).
//
// Let N be the kernel of kerpol(T_l) on M over Q (cuspidal, since the only
// Eisenstein eigenvalue of T_l is l + 1). M is the direct sum of N and the
// Hecke stable subspace N' = kerpol(T_l)(M), and both are stable under w.
// If the projection of the winding element to N vanishes, then e' lies in N',
// hence so does T e', and dim T e' <= dim S^- - dim N^-, where N^- is
// the (-1)-eigenspace of w on N. So perdim(p) >= dim N^-, and perdim(p) = d
// if dim N^- = d. The dimension of N^- equals the dimension of the
// (-1)-eigenspace of the dual action of w (given by the transpose of its matrix)
// on the dual space of N, which is computed modulo q: reduction modulo q is
// injective on that dual space (see reduce_dual_mod_q) and commutes with w.
// This uses that the modular symbols spaces over Q and over F_q have the
// same coordinates (Manin symbols), which is checked on T_2. (Computing w,
// Hecke operators, IsCuspidal or even a basis of the subspace N over Q
// would take more than ten minutes and much memory for p ~ 10^5.)
function verify_perdim(p, d, l, coeffs, q, T2q, Wq : orbits := false)
  t0 := Cputime();
  Fq := GF(q);
  kerpol := PolynomialRing(Rationals())!coeffs;
  assert Evaluate(kerpol, l + 1) ne 0; // N is cuspidal
  M := ModularSymbols(p, 2, +1);
  N := Kernel([<l, kerpol>], M);
  vprintf User2: "    kernel of kerpol(T_%o) on M (dim %o) has dimension %o (%o s)\n",
                 l, Dimension(M), Dimension(N), Cputime(t0);
  assert SparseMatrix(ChangeRing(HeckeOperator(M, 2), Fq)) eq T2q; // same coordinates
  Wt := Transpose(Wq);
  // dim N^- via reduction mod q: the kernel of v |-> v (w + 1) on the dual
  Nq := reduce_dual_mod_q(N, Fq);
  dimNm := #Nq - Rank(Matrix([v*Wt + v : v in Nq]));
  vprintf User2: "    its (-1)-eigenspace under w has dimension %o\n", dimNm;
  confirmed := dimNm eq d and IsZero(WindingElementProjection(N));
  vprintf User2: "    winding element projection to N is zero: %o (%o s)\n", confirmed, Cputime(t0);
  if not confirmed then
    printf "verify_perdim(p = %o): the kernel does not account for the defect %o;\n"
           cat " not confirmed (spurious deficiency mod q?)\n", p, d;
    return <0, [Integers()| ], false>;
  end if;
  if not orbits then return <d, [Integers()| ], true>; end if;
  // The Galois orbits: those in N with Fricke sign -1 (read off modulo q:
  // w acts on an orbit A as a scalar, which is the eigenvalue of the dual
  // action on the reduction of a dual basis vector of A) and zero winding
  // projection.
  dec := newform_orbits(N, p);
  assert &+[Dimension(A) : A in dec] eq Dimension(N);
  orbs := [Integers()| ];
  for A in dec do
    vq := reduce_dual_mod_q(A, Fq)[1];
    assert vq*Wt in {vq, -vq};
    if vq*Wt eq -vq and IsZero(WindingElementProjection(A)) then
      Append(~orbs, Dimension(A));
    end if;
  end for;
  assert &+orbs eq d;
  vprintf User2: "    pieces of dimensions %o, positive even rank orbits: %o (%o s)\n",
                 [Dimension(A) : A in dec], orbs, Cputime(t0);
  return <d, Sort(orbs), true>;
end function;

// perdim(p) with proof: returns <perdim(p), orbits, confirmed>.
function perdim(p : orbits := false)
  d, l, coeffs, q, T2q, Wq := Explode(screen_perdim(p));
  if d eq 0 then return <0, [Integers()| ], true>; end if;
  return verify_perdim(p, d, l, coeffs, q, T2q, Wq : orbits := orbits);
end function;

//============================================================================
printf "\n=============================================================================\n";
printf "1. Table 3: the primes p < 10^4 with perdim(p) > 0\n";
printf "=============================================================================\n\n";

// Table 3 as printed in the paper: <p, perdim(p)>.
TABLE3 := [
  <389, 1>, <433, 1>, <563, 1>, <571, 1>, <643, 1>, <709, 1>, <997, 2>, <1061, 2>, <1171, 1>,
  <1483, 1>, <1531, 1>, <1567, 3>, <1613, 1>, <1621, 1>, <1627, 1>, <1693, 3>, <1873, 1>, <1907, 1>,
  <1913, 3>, <1933, 1>, <2027, 1>, <2029, 2>, <2081, 2>, <2089, 1>, <2251, 1>, <2293, 2>, <2333, 4>,
  <2381, 2>, <2593, 4>, <2609, 2>, <2617, 2>, <2677, 1>, <2797, 1>, <2837, 1>, <2843, 4>, <2861, 2>,
  <2953, 1>, <2963, 2>, <3019, 2>, <3089, 2>, <3271, 3>, <3463, 2>, <3583, 2>, <3701, 2>, <3779, 1>,
  <3911, 2>, <3943, 4>, <3967, 1>, <4027, 2>, <4093, 2>, <4139, 1>, <4217, 2>, <4253, 3>, <4357, 1>,
  <4481, 1>, <4483, 2>, <4547, 1>, <4787, 2>, <4799, 1>, <4951, 2>, <5003, 3>, <5171, 1>, <5323, 3>,
  <5351, 2>, <5471, 3>, <5477, 2>, <5737, 3>, <5741, 1>, <5749, 2>, <5813, 1>, <5821, 2>, <6007, 2>,
  <6011, 1>, <6043, 1>, <6199, 1>, <6337, 2>, <6571, 1>, <6581, 3>, <6691, 1>, <6949, 3>, <7019, 1>,
  <7451, 1>, <7541, 1>, <7621, 2>, <7639, 2>, <7669, 1>, <7753, 3>, <7867, 1>, <7919, 2>, <7933, 2>,
  <8117, 3>, <8219, 1>, <8363, 1>, <8369, 2>, <8443, 1>, <8513, 3>, <8699, 1>, <8747, 1>, <9011, 4>,
  <9127, 1>, <9161, 1>, <9203, 1>, <9277, 1>, <9281, 2>, <9467, 1>, <9479, 1>, <9781, 2>, <9829, 2>,
  <9857, 3>, <9907, 2>, <9967, 2>
];
assert #TABLE3 eq 111;
assert #PrimesUpTo(10^4) eq 1229;

printf "Computing perdim(p) for all primes p < 10^4 (takes about 10 minutes) ...\n";
t1 := Cputime();
perdims := AssociativeArray(Integers()); // p -> <perdim, orbits> for perdim > 0
for p in PrimesInInterval(5, 10^4) do
  r := perdim(p : orbits := true);
  assert r[3]; // confirmed
  if r[1] gt 0 then perdims[p] := <r[1], r[2]>; end if;
end for;
printf "done (%o s).\n", Cputime(t1);
perdim_primes := Sort(Setseq(Keys(perdims)));
assert perdim_primes eq [e[1] : e in TABLE3];
assert forall{e : e in TABLE3 | perdims[e[1], 1] eq e[2]};
printf "Table 3 is correct: exactly %o primes below 10^4 have perdim(p) > 0.\n", #TABLE3;
// The Galois orbits: a single orbit except for 997, 1913, 2843, 9829.
several := [<p, perdims[p, 2]> : p in perdim_primes | #perdims[p, 2] gt 1];
assert several eq [<997, [1, 1]>, <1913, [1, 2]>, <2843, [1, 3]>, <9829, [1, 1]>];
printf "There is one Galois orbit of newforms with positive even analytic rank, except at\n";
for e in several do printf "  p = %o: orbits of sizes %o\n", e[1], e[2]; end for;

// Comparison with the LMFDB: the newforms of weight 2 and prime level with
// analytic rank >= 2. Those with positive even analytic rank are the ones
// with Fricke sign -1; the only form with Fricke sign +1 is 5077.2.a.a, which
// has analytic rank 3 and corresponds to the elliptic curve 5077a of rank 3.
load "lmfdb_mf_newforms_rk_ge_2.m"; // defines columns and data
assert columns[1] eq "label" and columns[2] eq "dim" and columns[7] eq "fricke_eigenval";
level := func<e | StringToInteger(Split(e[1], ".")[1])>;
lmfdb_rk2 := [<level(e), e[2], e[7]> : e in data]; // <p, dimension, Fricke sign>
assert #lmfdb_rk2 eq 116;
assert [e[1] : e in data | e[7] eq 1] eq ["5077.2.a.a"];
assert Rank(EllipticCurve("5077a1")) eq 3;
lmfdb_orbits := AssociativeArray(Integers());
for e in [f : f in lmfdb_rk2 | f[3] eq -1] do
  if IsDefined(lmfdb_orbits, e[1]) then
    Append(~lmfdb_orbits[e[1]], e[2]);
  else
    lmfdb_orbits[e[1]] := [e[2]];
  end if;
end for;
assert Keys(lmfdb_orbits) eq Keys(perdims);
assert forall{p : p in Keys(perdims) | Sort(lmfdb_orbits[p]) eq perdims[p, 2]};
printf "This agrees with the LMFDB data.\n\n";

//============================================================================
printf "\n=============================================================================\n";
printf "2. Cowan's data for 10^4 < p < 10^6 and the primes with perdim(p) > 4\n";
printf "=============================================================================\n\n";

// The LMFDB data: all Galois orbits of newforms of weight 2 and prime level
// p >= 10^4 of size at most 6, with their Fricke signs. By Cowan's
// computation, for 10^4 < p < 10^6 all other orbits are the two large
// orbits (one in each Fricke eigenspace).
load "lmfdb_mf_newforms_dim_le_6.m"; // defines columns and data
assert columns[1] eq "label" and columns[2] eq "dim" and columns[7] eq "fricke_eigenval";
forms := [<level(e), e[2], e[7]> : e in data]; // <p, orbit size, Fricke sign>
assert #forms eq 11198;
assert forall{f : f in forms | IsPrime(f[1]) and f[1] gt 10^4 and f[1] lt 10^6 and f[3] in {1, -1}};
// Orbit sizes 4, 5, 6.
assert [f[1] : f in forms | f[2] eq 6] eq [171713] and forall{f : f in forms | f[2] ne 6 or f[3] eq -1};
assert Sort([f[1] : f in forms | f[2] eq 5]) eq [26777, 86161] and forall{f : f in forms | f[2] ne 5 or f[3] eq -1};
assert #[f : f in forms | f[2] eq 4] eq 10;
assert Sort([f[1] : f in forms | f[2] eq 4 and f[3] eq -1]) eq [13681, 28057, 35977, 63607, 185599, 794111];
printf "Orbits of size 6: %o (sign -); of size 5: %o (sign -); ten of size 4, with sign -\n",
       [f[1] : f in forms | f[2] eq 6], Sort([f[1] : f in forms | f[2] eq 5]);
printf "  at %o.\n", Sort([f[1] : f in forms | f[2] eq 4 and f[3] eq -1]);
// The total size of the small orbits with negative Fricke sign, per prime.
small_minus := AssociativeArray(Integers()); // p -> sizes of the orbits with sign -
for f in forms do
  if f[3] eq 1 then continue; end if;
  if IsDefined(small_minus, f[1]) then
    Append(~small_minus[f[1]], f[2]);
  else
    small_minus[f[1]] := [f[2]];
  end if;
end for;
assert Max({&+small_minus[p] : p in Keys(small_minus)}) eq 7;
printf "For each prime, the total size of the small orbits with sign - is at most 7.\n\n";

// The primes p < 10^6 with perdim(p) > 4. Since perdim(p) counts newforms
// with Fricke sign -, and (by Cowan's data) the newforms with sign - form
// the small orbits above and one large orbit, we have
//   perdim(p) <= (total size of the small orbits with sign -) + c(p),
// where c(p) is the contribution of the large orbit: 0 if it has analytic
// rank 0, and its size otherwise. The determination in the paper assumes
// that c(p) = 0 for all 10^4 < p < 10^6 (see the discussion of the results
// of Iwaniec-Sarnak and of Martin's conjecture in the paper).
// Under this assumption, perdim(p) <= 4 unless the small orbits with sign -
// have total size at least 5, which happens for eleven primes.
cands := Sort([p : p in Keys(small_minus) | &+small_minus[p] ge 5]);
assert cands eq [17657, 26777, 35977, 86161, 89209, 133117, 140689, 171713, 591499, 613153, 879283];
printf "Primes whose small orbits with sign - have total size at least 5:\n";
for p in cands do printf "  %o: orbit sizes %o\n", p, Sort(small_minus[p]); end for;
// For eight of them we compute perdim(p) exactly (this does not use
// the assumption, since the winding element sees the large orbit as well).
printf "\nComputing perdim(p) for eight of these primes (takes about 50 minutes) ...\n";
// (expected value -1: only perdim(p) <= 4 is claimed)
expected := [<17657, 2>, <26777, 0>, <35977, 0>, <86161, 5>, <89209, 5>, <133117, 5>, <140689, -1>, <171713, 6>];
for e in expected do
  p := e[1];
  t1 := Cputime();
  r := perdim(p);
  assert r[3];
  printf "  perdim(%o) = %o (%o s)\n", p, r[1], Cputime(t1);
  assert e[2] lt 0 select r[1] le 4 else r[1] eq e[2];
end for;
// For the remaining three primes, the small orbits with sign - consist
// of orbits of size 1 (elliptic curves, whose ranks are known from the LMFDB;
// see part 3: the curves of positive even rank are listed there) and
// at most one orbit of size 2, so that perdim(p) <= (number of listed curves) + 2
// under the assumption above.
load "lmfdb_ec_curvedata_even_rank.m"; // defines columns and data
assert columns[2] eq "lmfdb_iso" and columns[4] eq "conductor" and columns[5] eq "rank";
ec := [<e[4], e[5]> : e in data]; // <conductor, rank>
assert #ec eq 144952;
for p in [591499, 613153, 879283] do
  sizes := Sort(small_minus[p]);
  assert sizes in {[1, 1, 1, 2], [1, 1, 1, 1, 1, 1, 1]};
  n1 := #[e : e in ec | e[1] eq p]; // elliptic curves of conductor p with positive even rank
  bound := n1 + &+[Integers()| s : s in sizes | s gt 1];
  printf "  p = %o: %o curves of positive even rank, so perdim(p) <= %o\n", p, n1, bound;
  assert bound le 4;
end for;
printf "Hence (under the assumption) perdim(p) > 4 for p < 10^6 exactly for\n";
printf "  p = 86161, 89209, 133117 (perdim 5) and p = 171713 (perdim 6).\n\n";

//============================================================================
printf "\n=============================================================================\n";
printf "3. Elliptic curves of prime conductor with positive even rank\n";
printf "=============================================================================\n\n";

// The LMFDB data: elliptic curves of prime conductor p < 3 * 10^8
// and rank 2, 4 or >= 6, one curve per isogeny class.
assert #Set([e[2] : e in data]) eq #data; // one curve per isogeny class
assert forall{e : e in ec | IsPrime(e[1]) and e[1] lt 3*10^8 and IsEven(e[2]) and e[2] ge 2};
printf "%o isogeny classes of positive even rank and prime conductor < 3 * 10^8;\n", #ec;
printf "ranks: %o\n", {* e[2] : e in ec *};
// Number of isogeny classes per conductor.
count := AssociativeArray(Integers());
for e in ec do
  if IsDefined(count, e[1]) then count[e[1]] +:= 1; else count[e[1]] := 1; end if;
end for;
by_count := AssociativeArray(Integers()); // k -> primes with k classes
for p in Keys(count) do
  k := count[p];
  if IsDefined(by_count, k) then Append(~by_count[k], p); else by_count[k] := [p]; end if;
end for;
assert Sort(Setseq(Keys(by_count))) eq [1, 2, 3, 4, 5, 6];
assert Sort(by_count[6]) eq [161137637] and Sort(by_count[5]) eq [4297609, 151141051];
assert #by_count[4] eq 6 and #by_count[3] eq 109 and #by_count[2] eq 2224;
printf "Primes with six such curves: %o; with five: %o;\n", by_count[6], Sort(by_count[5]);
printf "with four: %o;\n", Sort(by_count[4]);
printf "%o primes with three, %o with two, and %o with one such curve.\n",
       #by_count[3], #by_count[2], #by_count[1];
// Comparison with the Watkins heuristic: the number of curves with
// conductor in [X, X + H] should be about C (F(X + H) - F(X)) with
// F(X) = X^(19/24) (log X)^(3/5). We print the implied constant C for
// intervals of length 10^7 (it varies within a fairly small interval).
F := func<X | X^(19/24) * Log(X)^(3/5)>;
printf "\nCurves per interval of length 10^7 and implied constant C:\n";
H := 10^7;
for i in [0..29] do
  X := i*H;
  n := #[e : e in ec | e[1] gt X and e[1] le X + H];
  printf "  %2o * 10^7 < p <= %2o * 10^7: %5o curves, C = %.5o\n", i, i + 1, n, n / (F(X + H) - (i eq 0 select 0 else F(X)));
end for;

printf "\nAll claims in Section 8 verified. Total time: %o seconds.\n", Cputime(t0);
